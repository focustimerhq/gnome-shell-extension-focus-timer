{
  "uuid": "@EXTENSION_UUID@",
  "name": "Focus Timer",
  "description": "A Pomodoro timer for GNOME with top-bar controls, notifications showing remaining time, gentle break overlay, and a lock screen widget. Companion extension for the Focus Timer app.",
  "shell-version": [
    "48",
    "49",
    "50",
    "51.beta"
  ],
  "session-modes": [
    "user",
    "unlock-dialog"
  ],
  "settings-schema": "org.gnome.shell.extensions.focus-timer",
  "gettext-domain": "@GETTEXT_PACKAGE@",
  "url": "@PACKAGE_URL@",
  "donations": {
    "github": "kamilprusko",
    "liberapay": "kamilprusko",
    "kofi": "kamilprusko",
    "paypal": "kamilprusko"
  }
}
